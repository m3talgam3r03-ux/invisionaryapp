# Supabase — progetto in regione EU (GDPR): Postgres + Auth + Storage + Realtime.
# Copia questo file in ".env" e inserisci i valori del tuo progetto Supabase.
# Prefisso EXPO_PUBLIC_ = variabili esposte al client (solo la ANON key, MAI la service_role).
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY
